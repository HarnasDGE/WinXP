---
/**
 * TaskBar Component
 * Windows XP style taskbar at the bottom of the screen
 */
import StartButton from './StartButton.astro';
---

<div class="taskbar">
  <div class="taskbar-left">
    <StartButton />
    <div class="taskbar-separator"></div>
    <div class="quick-launch">
      <!-- Quick launch icons can be added here later -->
    </div>
  </div>

  <div class="taskbar-center">
    <!-- Running applications will appear here -->
  </div>

  <div class="taskbar-right">
    <div class="system-tray">
      <div class="tray-icons">
        <!-- System tray icons -->
        <span class="tray-icon" title="Volume">🔊</span>
        <span class="tray-icon" title="Network">🌐</span>
      </div>
      <div class="clock">
        <span id="taskbar-time">12:00 PM</span>
      </div>
    </div>
  </div>
</div>

<script>
  // Update clock
  function updateClock() {
    const clockElement = document.getElementById('taskbar-time');
    if (clockElement) {
      const now = new Date();
      const hours = now.getHours();
      const minutes = now.getMinutes().toString().padStart(2, '0');
      const ampm = hours >= 12 ? 'PM' : 'AM';
      const displayHours = hours % 12 || 12;
      clockElement.textContent = `${displayHours}:${minutes} ${ampm}`;
    }
  }

  // Update immediately and then every minute
  updateClock();
  setInterval(updateClock, 60000);
</script>

<style>
  .taskbar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 30px;
    background: linear-gradient(180deg,
      #245EDC 0%,
      #3F8CF3 6%,
      #3583F0 10%,
      #2C6CE7 40%,
      #245EDC 60%,
      #1E52C9 85%,
      #1941A5 100%
    );
    border-top: 1px solid #0831D9;
    display: flex;
    justify-content: space-between;
    align-items: stretch;
    z-index: 1000;
    font-family: 'Tahoma', sans-serif;
    font-size: 11px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15);
  }

  .taskbar-left {
    display: flex;
    align-items: stretch;
  }

  .taskbar-separator {
    width: 2px;
    margin: 4px 4px 4px 2px;
    background: linear-gradient(to right,
      #1441A8 0%,
      #0D2E7C 45%,
      #0D2E7C 50%,
      #5393F5 55%,
      #6BA3F7 100%
    );
    box-shadow:
      -1px 0 0 rgba(0, 0, 0, 0.1),
      1px 0 0 rgba(255, 255, 255, 0.1);
  }

  .quick-launch {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 0 2px;
  }

  .taskbar-center {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px 4px;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .taskbar-center::-webkit-scrollbar {
    display: none;
  }

  .taskbar-right {
    display: flex;
    align-items: stretch;
  }

  .system-tray {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 10px 0 8px;
    background: linear-gradient(180deg,
      #1B60D7 0%,
      #2D7EEB 8%,
      #2771E4 50%,
      #1A5FD6 92%,
      #1450BD 100%
    );
    border-left: 1px solid #0D2E7C;
    box-shadow:
      inset 1px 0 0 rgba(255, 255, 255, 0.08),
      inset -1px 0 0 rgba(0, 0, 0, 0.05);
    position: relative;
  }

  .system-tray::before {
    content: '';
    position: absolute;
    left: 0;
    top: 4px;
    bottom: 4px;
    width: 1px;
    background: linear-gradient(180deg,
      rgba(255, 255, 255, 0.2) 0%,
      rgba(255, 255, 255, 0.08) 50%,
      rgba(0, 0, 0, 0.15) 100%
    );
  }

  .tray-icons {
    display: flex;
    align-items: center;
    gap: 3px;
    padding-left: 2px;
  }

  .tray-icon {
    font-size: 14px;
    cursor: pointer;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.4));
    padding: 2px;
    border-radius: 2px;
    transition: background 0.1s;
  }

  .tray-icon:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .tray-icon:active {
    background: rgba(0, 0, 0, 0.15);
  }

  .clock {
    display: flex;
    align-items: center;
    color: #FFFFFF;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.6);
    font-weight: normal;
    font-size: 11px;
    padding: 3px 6px;
    cursor: pointer;
    user-select: none;
    border-radius: 2px;
    transition: background 0.1s;
    min-width: 60px;
    justify-content: center;
  }

  .clock:hover {
    background: linear-gradient(180deg,
      rgba(255, 255, 255, 0.15) 0%,
      rgba(255, 255, 255, 0.05) 50%,
      rgba(0, 0, 0, 0.05) 100%
    );
    box-shadow: inset 0 0 2px rgba(255, 255, 255, 0.2);
  }

  .clock:active {
    background: linear-gradient(180deg,
      rgba(0, 0, 0, 0.1) 0%,
      rgba(0, 0, 0, 0.05) 100%
    );
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.3);
  }
</style>
