---
/**
 * OrientationGuard Component
 * Shows a warning message when mobile device is in portrait mode
 */
---

<div id="orientation-guard" class="orientation-guard" style="display: none;">
  <div class="orientation-content">
    <div class="phone-icon">
      <svg width="80" height="120" viewBox="0 0 80 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="10" y="5" width="60" height="110" rx="8" stroke="currentColor" stroke-width="3" fill="none"/>
        <circle cx="40" cy="100" r="5" fill="currentColor"/>
        <line x1="20" y1="15" x2="60" y2="15" stroke="currentColor" stroke-width="2"/>
      </svg>
    </div>

    <h2 class="orientation-title">Obróć urządzenie</h2>
    <p class="orientation-message">
      Ta strona wymaga poziomego widoku ekranu.<br/>
      Proszę obrócić urządzenie.
    </p>

    <div class="rotation-arrows">
      <span class="arrow">↻</span>
    </div>
  </div>
</div>

<script>
  import { setupOrientationListener, getOrientationState } from '../scripts/orientationDetector';

  // Get the guard element
  const guard = document.getElementById('orientation-guard');

  if (guard) {
    // Check initial state
    const initialState = getOrientationState();
    guard.style.display = initialState.shouldShowWarning ? 'flex' : 'none';

    // Setup listener for orientation changes
    const cleanup = setupOrientationListener((state) => {
      guard.style.display = state.shouldShowWarning ? 'flex' : 'none';
    });

    // Cleanup on page unload (good practice)
    window.addEventListener('beforeunload', cleanup);
  }
</script>

<style>
  .orientation-guard {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    z-index: 9999;
    justify-content: center;
    align-items: center;
    padding: 20px;
  }

  .orientation-content {
    text-align: center;
    color: white;
    max-width: 90%;
  }

  .phone-icon {
    margin: 0 auto 30px;
    color: white;
    animation: rotatePhone 2s ease-in-out infinite;
  }

  @keyframes rotatePhone {
    0%, 100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(-15deg);
    }
    75% {
      transform: rotate(15deg);
    }
  }

  .orientation-title {
    font-size: 28px;
    font-weight: bold;
    margin: 0 0 15px 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  }

  .orientation-message {
    font-size: 16px;
    line-height: 1.6;
    margin: 0 0 30px 0;
    opacity: 0.95;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  }

  .rotation-arrows {
    font-size: 48px;
    animation: pulse 1.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.6;
      transform: scale(1.1);
    }
  }

  /* Hide on landscape orientation (this is a fallback) */
  @media (orientation: landscape) {
    .orientation-guard {
      display: none !important;
    }
  }

  /* Only show on mobile devices in portrait mode */
  @media (min-width: 769px) {
    .orientation-guard {
      display: none !important;
    }
  }
</style>
