---
/**
 * StartMenu Component
 * Windows XP Start Menu - authentic layout
 */
---

<div id="start-menu" class="start-menu" style="display: none;">
  <!-- Header with user info -->
  <div class="start-menu-header">
    <div class="user-avatar">
      <div class="avatar-image">🎭</div>
    </div>
    <div class="user-name">User</div>
  </div>

  <!-- Main panel -->
  <div class="start-menu-panel">
    <!-- Left panel - Frequently used programs (WHITE) -->
    <div class="start-menu-left">
      <div class="menu-section">
        <a href="#" class="menu-item">
          <span class="menu-icon">🌐</span>
          <div class="menu-text">
            <div class="menu-label">Internet</div>
            <div class="menu-sublabel">Internet Explorer</div>
          </div>
        </a>
        <a href="#" class="menu-item">
          <span class="menu-icon">📧</span>
          <div class="menu-text">
            <div class="menu-label">E-mail</div>
            <div class="menu-sublabel">Outlook Express</div>
          </div>
        </a>
      </div>

      <div class="menu-separator"></div>

      <div class="menu-section">
        <a href="#" class="menu-item">
          <span class="menu-icon">🎵</span>
          <div class="menu-text">
            <div class="menu-label">Windows Media Player</div>
          </div>
        </a>
        <a href="#" class="menu-item">
          <span class="menu-icon">🌍</span>
          <div class="menu-text">
            <div class="menu-label">Tour Windows XP</div>
          </div>
        </a>
        <a href="#" class="menu-item">
          <span class="menu-icon">🔄</span>
          <div class="menu-text">
            <div class="menu-label">Files and Settings Transfer Wizard</div>
          </div>
        </a>
      </div>

      <div class="all-programs-button">
        <span class="all-programs-text">All Programs</span>
        <div class="all-programs-arrow">▶</div>
      </div>
    </div>

    <!-- Right panel - System items (LIGHT BLUE) -->
    <div class="start-menu-right">
      <div class="menu-section">
        <a href="#" class="menu-item">
          <span class="menu-icon">📁</span>
          <span class="menu-label">My Documents</span>
        </a>
        <a href="#" class="menu-item with-arrow">
          <span class="menu-icon">🕐</span>
          <span class="menu-label">My Recent Documents</span>
          <span class="menu-arrow">▶</span>
        </a>
        <a href="#" class="menu-item">
          <span class="menu-icon">🖼️</span>
          <span class="menu-label">My Pictures</span>
        </a>
        <a href="#" class="menu-item">
          <span class="menu-icon">🎵</span>
          <span class="menu-label">My Music</span>
        </a>
        <a href="#" class="menu-item">
          <span class="menu-icon">💻</span>
          <span class="menu-label">My Computer</span>
        </a>
      </div>

      <div class="menu-separator"></div>

      <div class="menu-section">
        <a href="#" class="menu-item">
          <span class="menu-icon">⚙️</span>
          <span class="menu-label">Control Panel</span>
        </a>
        <a href="#" class="menu-item">
          <span class="menu-icon">🌐</span>
          <span class="menu-label">Set Program Access and Defaults</span>
        </a>
        <a href="#" class="menu-item">
          <span class="menu-icon">🖨️</span>
          <span class="menu-label">Printers and Faxes</span>
        </a>
      </div>

      <div class="menu-separator"></div>

      <div class="menu-section">
        <a href="#" class="menu-item">
          <span class="menu-icon">❓</span>
          <span class="menu-label">Help and Support</span>
        </a>
        <a href="#" class="menu-item">
          <span class="menu-icon">🔍</span>
          <span class="menu-label">Search</span>
        </a>
        <a href="#" class="menu-item">
          <span class="menu-icon">▶️</span>
          <span class="menu-label">Run...</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <div class="start-menu-footer">
    <a href="#" class="footer-button log-off">
      <span class="footer-icon">🔓</span>
      <span class="footer-label">Log Off</span>
    </a>
    <a href="#" class="footer-button turn-off">
      <span class="footer-icon">⏻</span>
      <span class="footer-label">Turn Off Computer</span>
    </a>
  </div>
</div>

<script>
  const startMenu = document.getElementById('start-menu');
  const startButton = document.getElementById('start-button');
  let isMenuOpen = false;

  function toggleMenu() {
    if (startMenu && startButton) {
      isMenuOpen = !isMenuOpen;

      if (isMenuOpen) {
        startMenu.style.display = 'flex';
        // Trigger reflow for animation
        void startMenu.offsetWidth;
        startMenu.classList.add('open');
        startButton.classList.add('active');
      } else {
        startMenu.classList.remove('open');
        startButton.classList.remove('active');
        // Wait for animation to complete before hiding
        setTimeout(() => {
          if (!isMenuOpen) {
            startMenu.style.display = 'none';
          }
        }, 200);
      }
    }
  }

  // Listen for toggle event from StartButton
  window.addEventListener('toggle-start-menu', toggleMenu);

  // Close menu when clicking outside
  document.addEventListener('click', (e) => {
    if (startMenu && startButton && isMenuOpen) {
      const target = e.target as HTMLElement;
      if (!startMenu.contains(target) && !startButton.contains(target)) {
        toggleMenu();
      }
    }
  });

  // Prevent menu items from closing menu when clicked (for now)
  if (startMenu) {
    startMenu.addEventListener('click', (e) => {
      e.stopPropagation();
    });
  }
</script>

<style>
  .start-menu {
    position: fixed;
    bottom: 30px;
    left: 0;
    flex-direction: column;
    background: white;
    border: 3px solid;
    border-color: #0831D9 #0831D9 transparent #0831D9;
    box-shadow:
      3px 0 8px rgba(0, 0, 0, 0.3),
      0 -3px 8px rgba(0, 0, 0, 0.3);
    border-radius: 12px 12px 0 0;
    width: 420px;
    z-index: 1001;
    font-family: 'Tahoma', sans-serif;
    font-size: 11px;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.12s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 0.12s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .start-menu.open {
    opacity: 1;
    transform: translateY(0);
  }

  /* Header */
  .start-menu-header {
    background: linear-gradient(to bottom,
      #4F92F6 0%,
      #3D7DD9 50%,
      #2F62B8 100%
    );
    border-radius: 9px 9px 0 0;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid #1F4A99;
    position: relative;
  }

  .start-menu-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right,
      transparent 0%,
      rgba(255, 255, 255, 0.3) 50%,
      transparent 100%
    );
  }

  .user-avatar {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, #F0F8FF 0%, #DCE9FF 50%, #C8DAFF 100%);
    border: 2px solid #FFFFFF;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.15),
      2px 2px 4px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    position: relative;
  }

  .avatar-image {
    font-size: 38px;
    filter: sepia(0.2) saturate(1.1);
  }

  .user-name {
    color: white;
    font-weight: bold;
    font-size: 14px;
    text-shadow:
      1px 1px 2px rgba(0, 0, 0, 0.7),
      0 0 3px rgba(0, 0, 0, 0.5);
    letter-spacing: 0.3px;
  }

  /* Main panel */
  .start-menu-panel {
    display: flex;
    min-height: 360px;
  }

  /* Left panel - WHITE background */
  .start-menu-left {
    width: 210px;
    background: white;
    border-right: 1px solid #B8D0F2;
    padding: 8px 0;
    display: flex;
    flex-direction: column;
  }

  /* Right panel - LIGHT BLUE background */
  .start-menu-right {
    flex: 1;
    background: linear-gradient(to bottom,
      #D3E5FA 0%,
      #C7DFFB 100%
    );
    padding: 4px 0;
  }

  .menu-section {
    padding: 2px 0;
  }

  .menu-separator {
    height: 1px;
    background: linear-gradient(to right,
      transparent 0%,
      #c0c0c0 10%,
      #c0c0c0 90%,
      transparent 100%
    );
    margin: 3px 4px;
  }

  .start-menu-right .menu-separator {
    background: #9DBBEA;
    margin: 3px 6px;
  }

  .menu-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 5px;
    text-decoration: none;
    color: #000;
    cursor: pointer;
    transition: all 0.03s ease;
    position: relative;
    min-height: 32px;
    border-radius: 3px;
    margin: 1px 2px;
  }

  .start-menu-left .menu-item {
    padding: 3px 6px;
    margin: 0 3px;
  }

  .menu-item:hover {
    background: linear-gradient(to right,
      #5A98F6 0%,
      #4682E8 50%,
      #366AD9 100%
    );
    color: white;
    box-shadow:
      inset 1px 1px 0 rgba(255, 255, 255, 0.3),
      inset -1px -1px 0 rgba(0, 0, 0, 0.1);
  }

  .menu-item:active {
    background: linear-gradient(to right,
      #2F62B8 0%,
      #4682E8 50%,
      #5A98F6 100%
    );
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  .menu-icon {
    font-size: 32px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .start-menu-right .menu-icon {
    font-size: 20px;
    width: 24px;
    height: 24px;
  }

  .menu-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .menu-label {
    font-size: 11px;
    font-weight: bold;
  }

  .menu-sublabel {
    font-size: 9px;
    color: #666;
    font-weight: normal;
  }

  .start-menu-right .menu-label {
    font-size: 11px;
    font-weight: normal;
  }

  .menu-arrow {
    font-size: 10px;
    margin-left: auto;
    padding-right: 4px;
  }

  /* All Programs button */
  .all-programs-button {
    margin-top: auto;
    padding: 5px 8px;
    background: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #c0c0c0;
    user-select: none;
    transition: all 0.03s ease;
    border-radius: 0 0 0 3px;
  }

  .all-programs-button:hover {
    background: linear-gradient(to right,
      #5A98F6 0%,
      #4682E8 50%,
      #366AD9 100%
    );
    box-shadow:
      inset 1px 1px 0 rgba(255, 255, 255, 0.3),
      inset -1px -1px 0 rgba(0, 0, 0, 0.1);
  }

  .all-programs-button:hover .all-programs-text {
    color: white;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.5);
  }

  .all-programs-button:active {
    background: linear-gradient(to right,
      #2F62B8 0%,
      #4682E8 50%,
      #5A98F6 100%
    );
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  .all-programs-text {
    color: #000;
    font-weight: bold;
    font-size: 11px;
    padding-left: 6px;
    transition: all 0.03s ease;
  }

  .all-programs-arrow {
    width: 24px;
    height: 24px;
    background: linear-gradient(to bottom,
      #9BD36D 0%,
      #88C25A 50%,
      #75B147 100%
    );
    border: 1px solid #4A7C2F;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    color: #1B5E20;
    font-weight: bold;
    box-shadow:
      inset 1px 1px 2px rgba(255, 255, 255, 0.5),
      inset -1px -1px 1px rgba(0, 0, 0, 0.1);
  }

  /* Footer */
  .start-menu-footer {
    display: flex;
    background: linear-gradient(to bottom,
      #2F62B8 0%,
      #3D7DD9 50%,
      #4F92F6 100%
    );
    border-top: 1px solid #1F4A99;
    position: relative;
  }

  .start-menu-footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right,
      transparent 0%,
      rgba(255, 255, 255, 0.3) 50%,
      transparent 100%
    );
  }

  .footer-button {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 11px 10px;
    text-decoration: none;
    color: white;
    cursor: pointer;
    transition: all 0.05s ease;
    font-size: 11px;
    font-weight: bold;
    text-shadow:
      1px 1px 2px rgba(0, 0, 0, 0.6),
      0 0 2px rgba(0, 0, 0, 0.4);
    position: relative;
  }

  .footer-button:first-child {
    border-right: 1px solid rgba(0, 0, 0, 0.2);
  }

  .footer-button:first-child::after {
    content: '';
    position: absolute;
    top: 0;
    right: -1px;
    bottom: 0;
    width: 1px;
    background: rgba(255, 255, 255, 0.2);
  }

  .footer-button:hover {
    background: rgba(255, 255, 255, 0.2);
    box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.3);
  }

  .footer-button:active {
    background: rgba(0, 0, 0, 0.2);
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.4);
  }

  .footer-icon {
    font-size: 18px;
    filter: drop-shadow(1px 1px 1px rgba(0, 0, 0, 0.5));
  }

  /* Mobile optimization */
  @media (max-width: 768px) {
    .start-menu {
      width: 90vw;
      max-width: 430px;
    }

    .menu-item {
      min-height: 44px;
      padding: 8px 6px;
    }

    .footer-button {
      padding: 14px 8px;
    }
  }
</style>
