---
/**
 * StartMenu Component
 * Windows XP Start Menu - authentic layout
 */
---

<div id="start-menu" class="start-menu" style="display: none;">
  <!-- Header with user info -->
  <div class="start-menu-header">
    <div class="user-avatar">
      <div class="avatar-image">🎭</div>
    </div>
    <div class="user-name">User</div>
  </div>

  <!-- Main panel -->
  <div class="start-menu-panel">
    <!-- Left panel - Frequently used programs (WHITE) -->
    <div class="start-menu-left">
      <div class="menu-section">
        <a href="#" class="menu-item">
          <span class="menu-icon">🌐</span>
          <div class="menu-text">
            <div class="menu-label">Internet</div>
            <div class="menu-sublabel">Internet Explorer</div>
          </div>
        </a>
        <a href="#" class="menu-item">
          <span class="menu-icon">📧</span>
          <div class="menu-text">
            <div class="menu-label">E-mail</div>
            <div class="menu-sublabel">Outlook Express</div>
          </div>
        </a>
      </div>

      <div class="menu-separator"></div>

      <div class="menu-section">
        <a href="#" class="menu-item">
          <span class="menu-icon">🎵</span>
          <div class="menu-text">
            <div class="menu-label">Windows Media Player</div>
          </div>
        </a>
        <a href="#" class="menu-item">
          <span class="menu-icon">🌍</span>
          <div class="menu-text">
            <div class="menu-label">Tour Windows XP</div>
          </div>
        </a>
        <a href="#" class="menu-item">
          <span class="menu-icon">🔄</span>
          <div class="menu-text">
            <div class="menu-label">Files and Settings Transfer Wizard</div>
          </div>
        </a>
      </div>

      <div class="all-programs-button">
        <span class="all-programs-text">All Programs</span>
        <div class="all-programs-arrow">▶</div>
      </div>
    </div>

    <!-- Right panel - System items (LIGHT BLUE) -->
    <div class="start-menu-right">
      <div class="menu-section">
        <a href="#" class="menu-item">
          <span class="menu-icon">📁</span>
          <span class="menu-label">My Documents</span>
        </a>
        <a href="#" class="menu-item with-arrow">
          <span class="menu-icon">🕐</span>
          <span class="menu-label">My Recent Documents</span>
          <span class="menu-arrow">▶</span>
        </a>
        <a href="#" class="menu-item">
          <span class="menu-icon">🖼️</span>
          <span class="menu-label">My Pictures</span>
        </a>
        <a href="#" class="menu-item">
          <span class="menu-icon">🎵</span>
          <span class="menu-label">My Music</span>
        </a>
        <a href="#" class="menu-item">
          <span class="menu-icon">💻</span>
          <span class="menu-label">My Computer</span>
        </a>
      </div>

      <div class="menu-separator"></div>

      <div class="menu-section">
        <a href="#" class="menu-item">
          <span class="menu-icon">⚙️</span>
          <span class="menu-label">Control Panel</span>
        </a>
        <a href="#" class="menu-item">
          <span class="menu-icon">🌐</span>
          <span class="menu-label">Set Program Access and Defaults</span>
        </a>
        <a href="#" class="menu-item">
          <span class="menu-icon">🖨️</span>
          <span class="menu-label">Printers and Faxes</span>
        </a>
      </div>

      <div class="menu-separator"></div>

      <div class="menu-section">
        <a href="#" class="menu-item">
          <span class="menu-icon">❓</span>
          <span class="menu-label">Help and Support</span>
        </a>
        <a href="#" class="menu-item">
          <span class="menu-icon">🔍</span>
          <span class="menu-label">Search</span>
        </a>
        <a href="#" class="menu-item">
          <span class="menu-icon">▶️</span>
          <span class="menu-label">Run...</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <div class="start-menu-footer">
    <a href="#" class="footer-button log-off">
      <span class="footer-icon">🔓</span>
      <span class="footer-label">Log Off</span>
    </a>
    <a href="#" class="footer-button turn-off">
      <span class="footer-icon">⏻</span>
      <span class="footer-label">Turn Off Computer</span>
    </a>
  </div>
</div>

<script>
  const startMenu = document.getElementById('start-menu');
  const startButton = document.getElementById('start-button');
  let isMenuOpen = false;

  function toggleMenu() {
    if (startMenu && startButton) {
      isMenuOpen = !isMenuOpen;

      if (isMenuOpen) {
        startMenu.style.display = 'flex';
        // Trigger reflow for animation
        void startMenu.offsetWidth;
        startMenu.classList.add('open');
        startButton.classList.add('active');
      } else {
        startMenu.classList.remove('open');
        startButton.classList.remove('active');
        // Wait for animation to complete before hiding
        setTimeout(() => {
          if (!isMenuOpen) {
            startMenu.style.display = 'none';
          }
        }, 200);
      }
    }
  }

  // Listen for toggle event from StartButton
  window.addEventListener('toggle-start-menu', toggleMenu);

  // Close menu when clicking outside
  document.addEventListener('click', (e) => {
    if (startMenu && startButton && isMenuOpen) {
      const target = e.target as HTMLElement;
      if (!startMenu.contains(target) && !startButton.contains(target)) {
        toggleMenu();
      }
    }
  });

  // Prevent menu items from closing menu when clicked (for now)
  if (startMenu) {
    startMenu.addEventListener('click', (e) => {
      e.stopPropagation();
    });
  }
</script>

<style>
  .start-menu {
    position: fixed;
    bottom: 30px;
    left: 0;
    flex-direction: column;
    background: white;
    border: 2px solid #245EDC;
    border-bottom: none;
    box-shadow: 3px -3px 8px rgba(0, 0, 0, 0.4);
    border-radius: 10px 10px 0 0;
    width: 430px;
    z-index: 1001;
    font-family: 'Tahoma', sans-serif;
    font-size: 11px;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.15s ease-out, transform 0.15s ease-out;
  }

  .start-menu.open {
    opacity: 1;
    transform: translateY(0);
  }

  /* Header */
  .start-menu-header {
    background: linear-gradient(to bottom,
      #5A8CED 0%,
      #3D6FE0 100%
    );
    border-radius: 8px 8px 0 0;
    padding: 8px 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 2px solid #2451C7;
  }

  .user-avatar {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, #E8F0FF 0%, #D0E4FF 50%, #B8D8FF 100%);
    border: 2px solid #FFFFFF;
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.1),
      2px 2px 4px rgba(0, 0, 0, 0.3);
    overflow: hidden;
    position: relative;
  }

  .avatar-image {
    font-size: 40px;
    filter: sepia(0.3) saturate(1.2);
  }

  .user-name {
    color: white;
    font-weight: bold;
    font-size: 13px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.6);
  }

  /* Main panel */
  .start-menu-panel {
    display: flex;
    min-height: 360px;
  }

  /* Left panel - WHITE background */
  .start-menu-left {
    width: 210px;
    background: white;
    border-right: 1px solid #B8D0F2;
    padding: 8px 0;
    display: flex;
    flex-direction: column;
  }

  /* Right panel - LIGHT BLUE background */
  .start-menu-right {
    flex: 1;
    background: linear-gradient(to bottom,
      #D3E5FA 0%,
      #C7DFFB 100%
    );
    padding: 4px 0;
  }

  .menu-section {
    padding: 2px 0;
  }

  .menu-separator {
    height: 1px;
    background: linear-gradient(to right,
      transparent 0%,
      #c0c0c0 10%,
      #c0c0c0 90%,
      transparent 100%
    );
    margin: 3px 4px;
  }

  .start-menu-right .menu-separator {
    background: #9DBBEA;
    margin: 3px 6px;
  }

  .menu-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 3px 4px;
    text-decoration: none;
    color: #000;
    cursor: pointer;
    transition: background 0.05s;
    position: relative;
    min-height: 32px;
  }

  .start-menu-left .menu-item {
    padding: 2px 8px;
  }

  .menu-item:hover {
    background: linear-gradient(to right,
      #3D8CFF 0%,
      #2371E8 100%
    );
    color: white;
  }

  .menu-icon {
    font-size: 32px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .start-menu-right .menu-icon {
    font-size: 20px;
    width: 24px;
    height: 24px;
  }

  .menu-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .menu-label {
    font-size: 11px;
    font-weight: bold;
  }

  .menu-sublabel {
    font-size: 9px;
    color: #666;
    font-weight: normal;
  }

  .start-menu-right .menu-label {
    font-size: 11px;
    font-weight: normal;
  }

  .menu-arrow {
    font-size: 10px;
    margin-left: auto;
    padding-right: 4px;
  }

  /* All Programs button */
  .all-programs-button {
    margin-top: auto;
    padding: 4px 6px;
    background: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #d0d0d0;
    user-select: none;
  }

  .all-programs-button:hover {
    background: linear-gradient(to right,
      #3D8CFF 0%,
      #2371E8 100%
    );
  }

  .all-programs-button:hover .all-programs-text {
    color: white;
  }

  .all-programs-text {
    color: #000;
    font-weight: bold;
    font-size: 11px;
    padding-left: 4px;
  }

  .all-programs-arrow {
    width: 22px;
    height: 22px;
    background: linear-gradient(to bottom,
      #8BC34A 0%,
      #7CB342 100%
    );
    border: 1px solid #558B2F;
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    color: #1B5E20;
    font-weight: bold;
    box-shadow: inset 1px 1px 1px rgba(255, 255, 255, 0.6);
  }

  /* Footer */
  .start-menu-footer {
    display: flex;
    background: linear-gradient(to bottom,
      #3D6FE0 0%,
      #5A8CED 100%
    );
    border-top: 2px solid #2451C7;
    border-radius: 0 0 8px 8px;
  }

  .footer-button {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 8px;
    text-decoration: none;
    color: white;
    cursor: pointer;
    transition: background 0.1s;
    font-size: 11px;
    font-weight: bold;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.5);
  }

  .footer-button:first-child {
    border-right: 1px solid rgba(255, 255, 255, 0.3);
  }

  .footer-button:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .footer-button:active {
    background: rgba(0, 0, 0, 0.15);
  }

  .footer-icon {
    font-size: 16px;
  }

  .log-off {
    background: linear-gradient(to bottom,
      rgba(255, 165, 0, 0.3) 0%,
      rgba(255, 140, 0, 0.2) 100%
    );
  }

  .turn-off {
    background: linear-gradient(to bottom,
      rgba(255, 69, 0, 0.3) 0%,
      rgba(255, 50, 0, 0.2) 100%
    );
  }

  /* Mobile optimization */
  @media (max-width: 768px) {
    .start-menu {
      width: 90vw;
      max-width: 430px;
    }

    .menu-item {
      min-height: 44px;
      padding: 8px 6px;
    }

    .footer-button {
      padding: 14px 8px;
    }
  }
</style>
