---
/**
 * Paint Application Component
 * Classic Windows XP Paint clone
 */
---

<div class="paint-app">
  <div class="paint-toolbar">
    <div class="toolbar-section">
      <div class="tool-label">Narzędzia:</div>
      <div class="tools-grid">
        <button class="tool-btn active" data-tool="pencil" title="Ołówek">✏️</button>
        <button class="tool-btn" data-tool="brush" title="Pędzel">🖌️</button>
        <button class="tool-btn" data-tool="eraser" title="Gumka">🧹</button>
        <button class="tool-btn" data-tool="fill" title="Wypełnij">🪣</button>
        <button class="tool-btn" data-tool="line" title="Linia">📏</button>
        <button class="tool-btn" data-tool="rectangle" title="Prostokąt">▭</button>
        <button class="tool-btn" data-tool="circle" title="Okrąg">⭕</button>
        <button class="tool-btn" data-tool="text" title="Tekst">A</button>
      </div>
    </div>

    <div class="toolbar-section">
      <div class="tool-label">Rozmiar:</div>
      <div class="size-selector">
        <button class="size-btn active" data-size="2">●</button>
        <button class="size-btn" data-size="5">●</button>
        <button class="size-btn" data-size="10">●</button>
        <button class="size-btn" data-size="15">●</button>
      </div>
    </div>

    <div class="toolbar-section">
      <div class="tool-label">Kolor:</div>
      <div class="color-palette">
        <button class="color-btn active" data-color="#000000" style="background: #000000;"></button>
        <button class="color-btn" data-color="#FFFFFF" style="background: #FFFFFF; border: 1px solid #999;"></button>
        <button class="color-btn" data-color="#FF0000" style="background: #FF0000;"></button>
        <button class="color-btn" data-color="#00FF00" style="background: #00FF00;"></button>
        <button class="color-btn" data-color="#0000FF" style="background: #0000FF;"></button>
        <button class="color-btn" data-color="#FFFF00" style="background: #FFFF00;"></button>
        <button class="color-btn" data-color="#FF00FF" style="background: #FF00FF;"></button>
        <button class="color-btn" data-color="#00FFFF" style="background: #00FFFF;"></button>
        <button class="color-btn" data-color="#808080" style="background: #808080;"></button>
        <button class="color-btn" data-color="#FFA500" style="background: #FFA500;"></button>
        <button class="color-btn" data-color="#800080" style="background: #800080;"></button>
        <button class="color-btn" data-color="#A52A2A" style="background: #A52A2A;"></button>
      </div>
      <input type="color" class="color-picker" data-color-picker value="#000000">
    </div>

    <div class="toolbar-section">
      <button class="action-btn" data-clear>🗑️ Wyczyść</button>
      <button class="action-btn" data-undo>↶ Cofnij</button>
    </div>
  </div>

  <div class="canvas-container">
    <canvas data-canvas width="800" height="600"></canvas>
  </div>
</div>

<style>
  .paint-app {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #d4d0c8;
    font-family: 'Tahoma', sans-serif;
  }

  .paint-toolbar {
    display: flex;
    gap: 16px;
    padding: 8px;
    background: #ece9d8;
    border-bottom: 2px solid;
    border-color: #808080 #fff #fff #808080;
    flex-wrap: wrap;
  }

  .toolbar-section {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .tool-label {
    font-size: 11px;
    font-weight: bold;
    color: #000;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
  }

  .tool-btn, .size-btn, .color-btn {
    width: 32px;
    height: 32px;
    background: #c0c0c0;
    border: 2px solid;
    border-color: #fff #808080 #808080 #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
  }

  .tool-btn:active, .size-btn:active, .color-btn:active {
    border-color: #808080 #fff #fff #808080;
  }

  .tool-btn.active, .size-btn.active, .color-btn.active {
    border-color: #808080 #fff #fff #808080;
    background: #b0b0b0;
  }

  .size-selector {
    display: flex;
    gap: 4px;
  }

  .size-btn:nth-child(1) { font-size: 8px; }
  .size-btn:nth-child(2) { font-size: 12px; }
  .size-btn:nth-child(3) { font-size: 18px; }
  .size-btn:nth-child(4) { font-size: 24px; }

  .color-palette {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 4px;
  }

  .color-picker {
    width: 100%;
    height: 32px;
    margin-top: 4px;
    cursor: pointer;
  }

  .action-btn {
    padding: 6px 12px;
    background: #c0c0c0;
    border: 2px solid;
    border-color: #fff #808080 #808080 #fff;
    cursor: pointer;
    font-family: 'Tahoma', sans-serif;
    font-size: 12px;
  }

  .action-btn:active {
    border-color: #808080 #fff #fff #808080;
  }

  .canvas-container {
    flex: 1;
    overflow: auto;
    padding: 16px;
    background: #d4d0c8;
  }

  canvas {
    background: white;
    border: 2px solid #808080;
    cursor: crosshair;
    display: block;
  }
</style>

<script>
  type Tool = 'pencil' | 'brush' | 'eraser' | 'fill' | 'line' | 'rectangle' | 'circle' | 'text';

  class PaintApp {
    private canvas!: HTMLCanvasElement;
    private ctx!: CanvasRenderingContext2D;
    private isDrawing: boolean = false;
    private currentTool: Tool = 'pencil';
    private currentColor: string = '#000000';
    private currentSize: number = 2;
    private startX: number = 0;
    private startY: number = 0;
    private snapshot: ImageData | null = null;
    private history: ImageData[] = [];
    private maxHistory: number = 20;

    constructor() {
      this.initElements();
      this.initCanvas();
      this.attachEventListeners();
    }

    private initElements(): void {
      this.canvas = document.querySelector('[data-canvas]')!;
      this.ctx = this.canvas.getContext('2d')!;
    }

    private initCanvas(): void {
      this.ctx.fillStyle = 'white';
      this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);
      this.saveToHistory();
    }

    private attachEventListeners(): void {
      // Tool selection
      document.querySelectorAll('[data-tool]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          document.querySelectorAll('[data-tool]').forEach(b => b.classList.remove('active'));
          (e.target as HTMLElement).classList.add('active');
          this.currentTool = (e.target as HTMLElement).dataset.tool as Tool;
        });
      });

      // Size selection
      document.querySelectorAll('[data-size]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          document.querySelectorAll('[data-size]').forEach(b => b.classList.remove('active'));
          (e.target as HTMLElement).classList.add('active');
          this.currentSize = parseInt((e.target as HTMLElement).dataset.size!);
        });
      });

      // Color selection
      document.querySelectorAll('[data-color]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          document.querySelectorAll('[data-color]').forEach(b => b.classList.remove('active'));
          (e.target as HTMLElement).classList.add('active');
          this.currentColor = (e.target as HTMLElement).dataset.color!;
        });
      });

      // Color picker
      const colorPicker = document.querySelector('[data-color-picker]') as HTMLInputElement;
      colorPicker.addEventListener('input', (e) => {
        this.currentColor = (e.target as HTMLInputElement).value;
        document.querySelectorAll('[data-color]').forEach(b => b.classList.remove('active'));
      });

      // Clear button
      document.querySelector('[data-clear]')!.addEventListener('click', () => {
        if (confirm('Czy na pewno chcesz wyczyścić płótno?')) {
          this.ctx.fillStyle = 'white';
          this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);
          this.saveToHistory();
        }
      });

      // Undo button
      document.querySelector('[data-undo]')!.addEventListener('click', () => {
        this.undo();
      });

      // Canvas drawing
      this.canvas.addEventListener('mousedown', (e) => this.startDrawing(e));
      this.canvas.addEventListener('mousemove', (e) => this.draw(e));
      this.canvas.addEventListener('mouseup', () => this.stopDrawing());
      this.canvas.addEventListener('mouseleave', () => this.stopDrawing());

      // Touch support
      this.canvas.addEventListener('touchstart', (e) => {
        e.preventDefault();
        const touch = e.touches[0];
        const rect = this.canvas.getBoundingClientRect();
        const mouseEvent = new MouseEvent('mousedown', {
          clientX: touch.clientX,
          clientY: touch.clientY
        });
        this.canvas.dispatchEvent(mouseEvent);
      });

      this.canvas.addEventListener('touchmove', (e) => {
        e.preventDefault();
        const touch = e.touches[0];
        const mouseEvent = new MouseEvent('mousemove', {
          clientX: touch.clientX,
          clientY: touch.clientY
        });
        this.canvas.dispatchEvent(mouseEvent);
      });

      this.canvas.addEventListener('touchend', (e) => {
        e.preventDefault();
        this.stopDrawing();
      });
    }

    private getCanvasCoords(e: MouseEvent): { x: number; y: number } {
      const rect = this.canvas.getBoundingClientRect();
      return {
        x: e.clientX - rect.left,
        y: e.clientY - rect.top
      };
    }

    private startDrawing(e: MouseEvent): void {
      this.isDrawing = true;
      const { x, y } = this.getCanvasCoords(e);
      this.startX = x;
      this.startY = y;

      // Save snapshot for shape tools
      if (['line', 'rectangle', 'circle'].includes(this.currentTool)) {
        this.snapshot = this.ctx.getImageData(0, 0, this.canvas.width, this.canvas.height);
      }

      // Fill tool
      if (this.currentTool === 'fill') {
        this.floodFill(Math.floor(x), Math.floor(y));
        this.saveToHistory();
      }
    }

    private draw(e: MouseEvent): void {
      if (!this.isDrawing) return;

      const { x, y } = this.getCanvasCoords(e);

      this.ctx.strokeStyle = this.currentColor;
      this.ctx.fillStyle = this.currentColor;
      this.ctx.lineWidth = this.currentSize;
      this.ctx.lineCap = 'round';
      this.ctx.lineJoin = 'round';

      switch (this.currentTool) {
        case 'pencil':
        case 'brush':
          this.ctx.beginPath();
          this.ctx.moveTo(this.startX, this.startY);
          this.ctx.lineTo(x, y);
          this.ctx.stroke();
          this.startX = x;
          this.startY = y;
          break;

        case 'eraser':
          this.ctx.clearRect(x - this.currentSize / 2, y - this.currentSize / 2, this.currentSize, this.currentSize);
          break;

        case 'line':
          if (this.snapshot) {
            this.ctx.putImageData(this.snapshot, 0, 0);
          }
          this.ctx.beginPath();
          this.ctx.moveTo(this.startX, this.startY);
          this.ctx.lineTo(x, y);
          this.ctx.stroke();
          break;

        case 'rectangle':
          if (this.snapshot) {
            this.ctx.putImageData(this.snapshot, 0, 0);
          }
          const width = x - this.startX;
          const height = y - this.startY;
          this.ctx.strokeRect(this.startX, this.startY, width, height);
          break;

        case 'circle':
          if (this.snapshot) {
            this.ctx.putImageData(this.snapshot, 0, 0);
          }
          const radius = Math.sqrt(Math.pow(x - this.startX, 2) + Math.pow(y - this.startY, 2));
          this.ctx.beginPath();
          this.ctx.arc(this.startX, this.startY, radius, 0, Math.PI * 2);
          this.ctx.stroke();
          break;
      }
    }

    private stopDrawing(): void {
      if (this.isDrawing) {
        this.isDrawing = false;
        this.snapshot = null;
        this.saveToHistory();
      }
    }

    private floodFill(startX: number, startY: number): void {
      const imageData = this.ctx.getImageData(0, 0, this.canvas.width, this.canvas.height);
      const targetColor = this.getPixelColor(imageData, startX, startY);
      const fillColor = this.hexToRgb(this.currentColor);

      // Don't fill if colors are the same
      if (this.colorsMatch(targetColor, fillColor)) return;

      const stack: [number, number][] = [[startX, startY]];
      const visited = new Set<string>();

      while (stack.length > 0) {
        const [x, y] = stack.pop()!;
        const key = `${x},${y}`;

        if (visited.has(key)) continue;
        if (x < 0 || x >= this.canvas.width || y < 0 || y >= this.canvas.height) continue;

        const currentColor = this.getPixelColor(imageData, x, y);
        if (!this.colorsMatch(currentColor, targetColor)) continue;

        visited.add(key);
        this.setPixelColor(imageData, x, y, fillColor);

        stack.push([x + 1, y], [x - 1, y], [x, y + 1], [x, y - 1]);
      }

      this.ctx.putImageData(imageData, 0, 0);
    }

    private getPixelColor(imageData: ImageData, x: number, y: number): [number, number, number, number] {
      const index = (y * imageData.width + x) * 4;
      return [
        imageData.data[index],
        imageData.data[index + 1],
        imageData.data[index + 2],
        imageData.data[index + 3]
      ];
    }

    private setPixelColor(imageData: ImageData, x: number, y: number, color: [number, number, number]): void {
      const index = (y * imageData.width + x) * 4;
      imageData.data[index] = color[0];
      imageData.data[index + 1] = color[1];
      imageData.data[index + 2] = color[2];
      imageData.data[index + 3] = 255;
    }

    private colorsMatch(c1: [number, number, number, number], c2: [number, number, number] | [number, number, number, number]): boolean {
      return c1[0] === c2[0] && c1[1] === c2[1] && c1[2] === c2[2];
    }

    private hexToRgb(hex: string): [number, number, number] {
      const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
      return result ? [
        parseInt(result[1], 16),
        parseInt(result[2], 16),
        parseInt(result[3], 16)
      ] : [0, 0, 0];
    }

    private saveToHistory(): void {
      const imageData = this.ctx.getImageData(0, 0, this.canvas.width, this.canvas.height);
      this.history.push(imageData);
      if (this.history.length > this.maxHistory) {
        this.history.shift();
      }
    }

    private undo(): void {
      if (this.history.length > 1) {
        this.history.pop(); // Remove current state
        const previousState = this.history[this.history.length - 1];
        this.ctx.putImageData(previousState, 0, 0);
      }
    }
  }

  // Initialize Paint app
  if (document.querySelector('[data-canvas]')) {
    new PaintApp();
  }
</script>
